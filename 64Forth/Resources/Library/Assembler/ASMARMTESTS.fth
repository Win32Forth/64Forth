\ ASMARMTESTS.fth — ASMARM64 host regression suite
\ Synced Aug 23, 2026 3:16 PM — keep 64TCOMARM64/ASMARMTESTS.fth and Library/Assembler/ASMARMTESTS.fth identical.
\
\ Public domain.
\   FROMLIB FLOAD Assembler/asmarm64.fth
\   FROMLIB FLOAD Assembler/ASMARMTESTS.fth
\   ASM-TESTS
\
\ Twin: Documents/64TCOM/64TCOMARM64/ASMARMTESTS.fth
\ TARGETARM64 does not load this file.

FORTH DEFINITIONS DECIMAL

[UNDEFINED] ASM-CLEAR [IF]
  S" ASMARMTESTS: load Assembler/asmarm64.fth first" TYPE CR
  \\S
[THEN]

VARIABLE ASM-FAILS
VARIABLE ASM-PASSES
VARIABLE ASM-LEAF
VARIABLE ASM-TMP
VARIABLE ASM-EQ-GOT
VARIABLE ASM-EQ-WANT
CREATE ASM-EQ-MSG  128 ALLOT

: ASM-PASS  ( -- )  1 ASM-PASSES +! ;
: ASM-FAIL  ( -- )  1 ASM-FAILS +! ;

: ASM-REQUIRE-HOST  ( -- )
  [DEFINED] ASMARM64-HOST? [IF]
    ASMARM64-HOST? 0= IF
      S" ASMARMTESTS: host buffer path only" TYPE CR ABORT
    THEN
  [ELSE]
    S" ASMARMTESTS: load asmarm64.fth first" TYPE CR ABORT
  [THEN]
  ;

: ASM-MSG!  ( c-addr u -- )
  DUP 127 > IF DROP 127 THEN
  DUP ASM-EQ-MSG C!
  ASM-EQ-MSG 1+ SWAP MOVE
  ;

: ASM-EQ  ( got want c-addr u -- )
  ASM-MSG!
  ASM-EQ-WANT !
  ASM-EQ-GOT !
  ASM-EQ-GOT @ ASM-EQ-WANT @ = IF
    ASM-PASS
  ELSE
    ASM-EQ-MSG COUNT TYPE
    S" : got " TYPE ASM-EQ-GOT @ U.
    S" want " TYPE ASM-EQ-WANT @ U. CR
    ASM-FAIL
  THEN
  ;

ALSO ASMARM64

: ASM-START  ( -- )  ASM-CLEAR ALIGN4-T ;

: ASM-EXPECT-W0  ( expect c-addr u -- )
  ASM-MSG!
  ASM-EQ-WANT !
  0 W@-T ASM-EQ-GOT !
  ASM-EQ-GOT @ ASM-EQ-WANT @ = IF
    ASM-PASS
  ELSE
    ASM-EQ-MSG COUNT TYPE
    S" : got " TYPE ASM-EQ-GOT @ U.
    S" want " TYPE ASM-EQ-WANT @ U. CR
    ASM-FAIL
  THEN
  ;

: ASM-LEAF-BEGIN  ( -- )
  ASM-START HERE-T ASM-LEAF !
  ;

: ASM-EXPECT-X0  ( want c-addr u -- )
  ASM-MSG!
  ASM-EQ-WANT !
  ASM-LEAF @ ASM-RUN-LEAF ASM-EQ-GOT !
  ASM-EQ-GOT @ ASM-EQ-WANT @ = IF
    ASM-PASS
  ELSE
    ASM-EQ-MSG COUNT TYPE
    S" : got " TYPE ASM-EQ-GOT @ U.
    S" want " TYPE ASM-EQ-WANT @ U. CR
    ASM-FAIL
  THEN
  ;

\ ----- encode goldens (values from host ASMARM64) -----

: T-ENC-BASIC  ( -- )
  S" --- encode: basic ---" TYPE CR
  ASM-START NOP,   3573751839 S" NOP" ASM-EXPECT-W0
  ASM-START RET,   3596551104 S" RET" ASM-EXPECT-W0
  ASM-START BTI,   3573752927 S" BTI" ASM-EXPECT-W0
  ASM-START BTI-J, 3573752991 S" BTI-J" ASM-EXPECT-W0
  ASM-START BTI-JC, 3573753055 S" BTI-JC" ASM-EXPECT-W0
  ;

: T-ENC-MOV-ALU  ( -- )
  S" --- encode: mov/alu ---" TYPE CR
  ASM-START 7 X0 0 MOVZ-X,     3531604192 S" MOVZ" ASM-EXPECT-W0
  ASM-START X1 X0 MOV-X-X,     2852193248 S" MOV-X-X" ASM-EXPECT-W0
  ASM-START X1 X0 X0 ADD-X-X,  2332098560 S" ADD-X-X" ASM-EXPECT-W0
  ASM-START X1 X0 X0 SUB-X-X,  3405840384 S" SUB-X-X" ASM-EXPECT-W0
  ASM-START X1 X0 X0 AND-X,    2315321344 S" AND-X" ASM-EXPECT-W0
  ASM-START X1 X0 X0 ORR-X,    2852192256 S" ORR-X" ASM-EXPECT-W0
  ASM-START X1 X0 X0 EOR-X,    3389063168 S" EOR-X" ASM-EXPECT-W0
  ASM-START 1 X0 X0 ADD-IMM,   2432697344 S" ADD-IMM" ASM-EXPECT-W0
  ASM-START 3 X0 X0 SUB-IMM,   3506441216 S" SUB-IMM" ASM-EXPECT-W0
  ;

: T-ENC-SHIFT-MUL  ( -- )
  S" --- encode: shift/mul ---" TYPE CR
  ASM-START 3 X0 X0 LSL-IMM,   3548246016 S" LSL-IMM" ASM-EXPECT-W0
  ASM-START 2 X0 X0 LSR-IMM,   3544382464 S" LSR-IMM" ASM-EXPECT-W0
  ASM-START 1 X0 X0 ASR-IMM,   2470575104 S" ASR-IMM" ASM-EXPECT-W0
  ASM-START X1 X0 X0 MUL-X,    2600565760 S" MUL-X" ASM-EXPECT-W0
  ASM-START X1 X0 X0 UDIV-X,   2596341760 S" UDIV-X" ASM-EXPECT-W0
  ;

: T-ENC-MEM-BR  ( -- )
  S" --- encode: mem/branch ---" TYPE CR
  ASM-START X0 X19 LDR-X0,       4181721696 S" LDR-X0" ASM-EXPECT-W0
  ASM-START X0 X19 STR-X0,       4177527392 S" STR-X0" ASM-EXPECT-W0
  ASM-START X0 X19 -8 STR-PRE,   4162817632 S" STR-PRE" ASM-EXPECT-W0
  ASM-START X0 X19 8 LDR-POST,   4164978272 S" LDR-POST" ASM-EXPECT-W0
  ASM-START 0 B-IMM,             335544320 S" B-IMM#0" ASM-EXPECT-W0
  ASM-START X0 0 CBZ-X,          3019898880 S" CBZ" ASM-EXPECT-W0
  ASM-START X0 0 CBNZ-X,         3036676096 S" CBNZ" ASM-EXPECT-W0
  ;

: T-ENC-W-CSEL  ( -- )
  S" --- encode: W/CSEL ---" TYPE CR
  ASM-START 7 W0 0 MOVZ-W,       1384120544 S" MOVZ-W" ASM-EXPECT-W0
  ASM-START W1 W0 W0 ADD-W-W,    184614912 S" ADD-W-W" ASM-EXPECT-W0
  ASM-START X1 X0 EQ X0 CSEL-X,  2592145408 S" CSEL" ASM-EXPECT-W0
  ASM-START EQ X0 CSET-X,        2594117600 S" CSET" ASM-EXPECT-W0
  ;

: T-ENC-PAIR-ADR  ( -- )
  S" --- encode: pair/ADR ---" TYPE CR
  ASM-START 0 X0 ADR,            268435456 S" ADR#0" ASM-EXPECT-W0
  ASM-START 0 X0 ADRP,           2415919104 S" ADRP#0" ASM-EXPECT-W0
  ASM-START X0 X1 X19 0 STP-OFF, 2835351136 S" STP-OFF#0" ASM-EXPECT-W0
  ASM-START X0 X1 X19 16 LDP-OFF, 2839610976 S" LDP-OFF#16" ASM-EXPECT-W0
  ASM-START X30 XZR SP -16 STP-PRE, 2847899646 S" STP-PRE SP" ASM-EXPECT-W0
  ;

\ ----- runnable leaves -----

: T-RUN-CONST  ( -- )
  S" --- run: const ---" TYPE CR
  ASM-LEAF-BEGIN 7 X0 MOV-X-IMM64, RET,  7 S" #7" ASM-EXPECT-X0
  ASM-LEAF-BEGIN 0 X0 MOV-X-IMM64, RET,  0 S" #0" ASM-EXPECT-X0
  ASM-LEAF-BEGIN $ABCD X0 MOV-X-IMM64, RET,  $ABCD S" #ABCD" ASM-EXPECT-X0
  ;

: T-RUN-ALU  ( -- )
  S" --- run: ALU ---" TYPE CR
  ASM-LEAF-BEGIN
  6 X0 MOV-X-IMM64, 1 X1 MOV-X-IMM64, X1 X0 X0 ADD-X-X, RET,
  7 S" 6+1" ASM-EXPECT-X0
  ASM-LEAF-BEGIN
  10 X0 MOV-X-IMM64, 3 X1 MOV-X-IMM64, X1 X0 X0 SUB-X-X, RET,
  7 S" 10-3" ASM-EXPECT-X0
  ASM-LEAF-BEGIN
  6 X0 MOV-X-IMM64, 7 X1 MOV-X-IMM64, X1 X0 X0 AND-X, RET,
  6 S" AND" ASM-EXPECT-X0
  ASM-LEAF-BEGIN
  4 X0 MOV-X-IMM64, 3 X1 MOV-X-IMM64, X1 X0 X0 ORR-X, RET,
  7 S" ORR" ASM-EXPECT-X0
  ASM-LEAF-BEGIN
  15 X0 MOV-X-IMM64, 8 X1 MOV-X-IMM64, X1 X0 X0 EOR-X, RET,
  7 S" EOR" ASM-EXPECT-X0
  ASM-LEAF-BEGIN
  5 X0 MOV-X-IMM64, 1 X0 X0 ADD-IMM, 1 X0 X0 ADD-IMM, RET,
  7 S" ADD-IMM" ASM-EXPECT-X0
  ;

: T-RUN-MULDIV-SHIFT  ( -- )
  S" --- run: mul/div/shift ---" TYPE CR
  ASM-LEAF-BEGIN
  3 X0 MOV-X-IMM64, 5 X1 MOV-X-IMM64, X1 X0 X0 MUL-X, RET,
  15 S" MUL" ASM-EXPECT-X0
  ASM-LEAF-BEGIN
  21 X0 MOV-X-IMM64, 3 X1 MOV-X-IMM64, X1 X0 X0 UDIV-X, RET,
  7 S" UDIV" ASM-EXPECT-X0
  ASM-LEAF-BEGIN
  1 X0 MOV-X-IMM64, 3 X0 X0 LSL-IMM, RET,
  8 S" LSL" ASM-EXPECT-X0
  ASM-LEAF-BEGIN
  28 X0 MOV-X-IMM64, 2 X0 X0 LSR-IMM, RET,
  7 S" LSR" ASM-EXPECT-X0
  ASM-LEAF-BEGIN
  -8 X0 MOV-X-IMM64, 1 X0 X0 ASR-IMM, RET,
  -4 S" ASR" ASM-EXPECT-X0
  ;

: T-RUN-MOV-AHEAD  ( -- )
  S" --- run: mov/AHEAD ---" TYPE CR
  ASM-LEAF-BEGIN
  42 X1 MOV-X-IMM64, X1 X0 MOV-X-X, RET,
  42 S" MOV X0,X1" ASM-EXPECT-X0
  ASM-LEAF-BEGIN
  AHEAD, 99 X0 MOV-X-IMM64, THEN, 3 X0 MOV-X-IMM64, RET,
  3 S" AHEAD," ASM-EXPECT-X0
  ;

: T-RUN-CBNZ  ( -- )
  S" --- run: CBNZ loop ---" TYPE CR
  ASM-LEAF-BEGIN
  0 X0 MOV-X-IMM64, 3 X1 MOV-X-IMM64,
  ALIGN4-T HERE-T ASM-TMP !
  1 X0 X0 ADD-IMM, 1 X1 X1 SUB-IMM,
  ALIGN4-T ASM-TMP @ HERE-T - 4 / X1 SWAP CBNZ-X,
  RET,
  3 S" CBNZ count" ASM-EXPECT-X0
  ;

: T-RUN-LLABEL  ( -- )
  S" --- run: BR>LL ---" TYPE CR
  LL-INIT
  ASM-LEAF-BEGIN
  7 X0 MOV-X-IMM64, 3 BR>LL 0 X0 MOV-X-IMM64, 3 LL: RET,
  7 S" BR>LL fwd" ASM-EXPECT-X0
  ;

: T-RUN-CMP-CSEL  ( -- )
  S" --- run: CMP/CSET/CSEL ---" TYPE CR
  ASM-LEAF-BEGIN
  5 X0 MOV-X-IMM64, 5 X1 MOV-X-IMM64, X1 X0 CMP-X, EQ X0 CSET-X, RET,
  1 S" CSET EQ" ASM-EXPECT-X0
  ASM-LEAF-BEGIN
  5 X0 MOV-X-IMM64, 6 X1 MOV-X-IMM64, X1 X0 CMP-X, EQ X0 CSET-X, RET,
  0 S" CSET !EQ" ASM-EXPECT-X0
  ASM-LEAF-BEGIN
  0 X0 MOV-X-IMM64, 11 X1 MOV-X-IMM64, 22 X2 MOV-X-IMM64,
  XZR X0 CMP-X, X2 X1 EQ X0 CSEL-X, RET,
  11 S" CSEL" ASM-EXPECT-X0
  ;

: T-RUN-WREGS  ( -- )
  S" --- run: W ---" TYPE CR
  ASM-LEAF-BEGIN
  6 W0 MOV-W-IMM32, 1 W1 MOV-W-IMM32, W1 W0 W0 ADD-W-W, RET,
  7 S" W ADD" ASM-EXPECT-X0
  ;

: T-RUN-STACK-ABI  ( -- )
  S" --- run: DSP push/pop ---" TYPE CR
  ASM-LEAF-BEGIN
  7 X0 MOV-X-IMM64, X0 X19 -8 STR-PRE,
  0 X0 MOV-X-IMM64, X0 X19 8 LDR-POST, RET,
  7 S" STR-PRE/LDR-POST" ASM-EXPECT-X0
  ;

: T-RUN-LIT  ( -- )
  S" --- run: LIT helpers ---" TYPE CR
  ASM-LEAF-BEGIN 9 LIT-X0, RET,  9 S" LIT-X0" ASM-EXPECT-X0
  ASM-LEAF-BEGIN
  3 LIT-PUSH-X0, 4 LIT-PUSH-X0,
  X1 X19 8 LDR-POST, X1 X0 X0 ADD-X-X, RET,
  7 S" LIT-PUSH" ASM-EXPECT-X0
  ;

: T-RUN-TIF  ( -- )
  S" --- run: TIF ---" TYPE CR
  ASM-LEAF-BEGIN
  -1 X0 MOV-X-IMM64, TIF 7 X0 MOV-X-IMM64, TTHEN RET,
  7 S" TIF true" ASM-EXPECT-X0
  ASM-LEAF-BEGIN
  0 X0 MOV-X-IMM64, TIF 7 X0 MOV-X-IMM64, TTHEN RET,
  0 S" TIF false" ASM-EXPECT-X0
  ASM-LEAF-BEGIN
  0 X0 MOV-X-IMM64, TIF 1 X0 MOV-X-IMM64, TELSE 7 X0 MOV-X-IMM64, TTHEN RET,
  7 S" TELSE" ASM-EXPECT-X0
  ;

: T-RUN-UNROLL  ( -- )
  S" --- run: unrolled ---" TYPE CR
  ASM-LEAF-BEGIN
  0 X0 MOV-X-IMM64, 1 X1 MOV-X-IMM64,
  X1 X0 X0 ADD-X-X, X1 X0 X0 ADD-X-X, X1 X0 X0 ADD-X-X, RET,
  3 S" +1 thrice" ASM-EXPECT-X0
  ;

PREVIOUS

: ASM-TESTS  ( -- )
  ASM-REQUIRE-HOST
  0 ASM-FAILS !  0 ASM-PASSES !
  S" === ASMARMTESTS ===" TYPE CR
  ALSO ASMARM64
  T-ENC-BASIC
  T-ENC-MOV-ALU
  T-ENC-SHIFT-MUL
  T-ENC-MEM-BR
  T-ENC-W-CSEL
  T-ENC-PAIR-ADR
  T-RUN-CONST
  T-RUN-ALU
  T-RUN-MULDIV-SHIFT
  T-RUN-MOV-AHEAD
  T-RUN-CBNZ
  T-RUN-LLABEL
  T-RUN-CMP-CSEL
  T-RUN-WREGS
  T-RUN-STACK-ABI
  T-RUN-LIT
  T-RUN-TIF
  T-RUN-UNROLL
  PREVIOUS
  S" === ASMARMTESTS: " TYPE ASM-PASSES @ . S" passed, " TYPE
  ASM-FAILS @ . S" failed ===" TYPE CR
  ASM-FAILS @ IF S" ASMARMTESTS: FAILED" TYPE CR ABORT THEN
  S" ASMARMTESTS: OK" TYPE CR
  ;

: ASM-HOST-SMOKE  ( -- )  ASM-TESTS ;

S" ASMARMTESTS loaded.  Run: ASM-TESTS" TYPE CR
